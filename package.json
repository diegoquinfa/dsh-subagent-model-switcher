{
  "name": "dsh-subagent-model-switcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alt+K modal that stores a model and reasoning effort per subagent delegation tool, plus three ported Gentle AI roles (worker, verify, explore).",
  "license": "UNLICENSED",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
